---
import type { GetStaticPathsResult } from 'astro'
import { readFileSync } from 'node:fs'
import { join } from 'node:path'
import { getCollection } from 'astro:content'
import { allLocales } from '@/config'
import Layout from '@/layouts/Layout.astro'

interface UnitNode {
  dict_keys: string[]
  type: string
  number: string
  formation?: string
  disband?: string
  status_note?: string
  camo_url?: string
  reference_url?: string
  history_note?: string
  children: string[]
}

interface RegistryData {
  units: Record<string, UnitNode>
}

export async function getStaticPaths(): Promise<GetStaticPathsResult> {
  const gspRegistryPath = join(process.cwd(), 'data/dictionaries/units_registry.json')
  const gspDictPath = join(process.cwd(), 'data/dictionaries/units_dict.json')

  const gspRegistryData = readFileSync(gspRegistryPath, 'utf-8')
  const gspDictData = readFileSync(gspDictPath, 'utf-8')
  const gspRegistry = JSON.parse(gspRegistryData) as RegistryData
  const gspDict = JSON.parse(gspDictData) as Record<string, string>

  return allLocales.flatMap(lang =>
    Object.entries(gspRegistry.units).map(([unitId, unit]: [string, UnitNode]) => ({
      params: { lang, unit_id: unitId },
      props: { unit, dict: gspDict },
    })),
  )
}

const { unit, dict } = Astro.props as { unit: UnitNode, dict: Record<string, string> }
const unitId = Astro.params.unit_id as string
const lang = Astro.params.lang as string

// Получить norm из словаря
const normKey = unit.dict_keys[0]
const norm = dict[normKey] || normKey

// Получить карточки из коллекции fallen
const fallen = await getCollection('fallen')
const fallenInUnit = fallen.filter(card => card.data.service.unit_id === unitId)

// Загружаем registry для доступа к дочерним элементам в template
const registryPath = join(process.cwd(), 'data/dictionaries/units_registry.json')
const registryData = readFileSync(registryPath, 'utf-8')
const registry = JSON.parse(registryData) as RegistryData;
---

<Layout>
  <h1>{norm}</h1>

  <div class="unit-info">
    <p><strong>Тип:</strong> {unit.type}</p>
    <p><strong>Номер:</strong> {unit.number}</p>
    {unit.formation && <p><strong>Формирование:</strong> {unit.formation}</p>}
    {unit.disband && <p><strong>Расформирование:</strong> {unit.disband}</p>}
    {unit.status_note && <p><strong>Статус:</strong> {unit.status_note}</p>}
    {unit.camo_url && <p><strong>ЦАМО:</strong> <a href={unit.camo_url} target="_blank">ссылка</a></p>}
    {unit.reference_url && <p><strong>Источник:</strong> <a href={unit.reference_url} target="_blank">ссылка</a></p>}
  </div>

  {unit.history_note && (
    <div class="history">
      <h2>История</h2>
      <p>{unit.history_note}</p>
    </div>
  )}

  {unit.children.length > 0 && (
    <div class="children">
      <h2>Состав</h2>
      <ul>
        {unit.children.map((childId: string) => {
          const childUnit = registry.units[childId]
          const childNorm = dict[childUnit.dict_keys[0]] || childUnit.dict_keys[0]
          return (
            <li>
              <a href={`/${lang}/memorial/units/${childId}/`}>{childNorm}</a>
            </li>
          )
        })}
      </ul>
    </div>
  )}

  <div class="fallen">
    <h2>Павшие ({fallenInUnit.length})</h2>
    <ul>
      {fallenInUnit.map(card => (
        <li>
          <a href={`/${lang}/memorial/card/${card.data.slug}/`}>
            {card.data.person.last_name} {card.data.person.first_name[0]}.
            {card.data.person.middle_name ? `${card.data.person.middle_name[0]}.` : ''}
          </a>
          {' — '}
          {card.data.service.rank_norm}, погиб {card.data.person.death_date}
        </li>
      ))}
    </ul>
  </div>
</Layout>
