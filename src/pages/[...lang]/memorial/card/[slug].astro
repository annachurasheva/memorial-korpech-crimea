---
import Layout from '@/layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import CardFull from '@/components/memorial/CardFull.astro';

const { slug } = Astro.params;
const card = await getEntry('fallen', `${slug}.md`);
---

<Layout>
  <CardFull data={card.data} />
</Layout>