---
import Layout from '@/layouts/Layout.astro';
import { getEntry } from 'astro:content';
import CardFull from '@/components/memorial/CardFull.astro';

const { slug } = Astro.params;
const card = await getEntry('fallen', `${slug}.md`);

if (!card) {
  return Astro.redirect('/404');
}
---

<Layout>
  <CardFull data={card.data} />
</Layout>