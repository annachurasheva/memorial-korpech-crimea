---
import { getPageInfo } from '@/utils/page'
import { ui } from '@/i18n/ui'

const { currentLang } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
---

<html lang={currentLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{currentUI.privacyTitle ?? 'Политика конфиденциальности'} | {currentUI.title ?? 'Мемориал Корпечь'}</title>
  </head>
  <body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100">
    <main class="container mx-auto px-4 py-8 max-w-3xl">
      {currentLang === 'en' ? (
        <article>
          <h1 class="text-3xl font-bold mb-6">Privacy Policy</h1>
          <p class="mb-4 text-yellow-600 dark:text-yellow-400">Translation in progress</p>
          <p class="mb-4">
            Please see the <a href="/privacy/" class="underline text-blue-600 hover:text-blue-800">Russian version</a>.
          </p>
        </article>
      ) : (
        <article>
          <h1 class="text-3xl font-bold mb-6">Политика конфиденциальности</h1>

          <section class="mb-6">
            <h2 class="text-xl font-semibold mb-3">1. Общие положения</h2>
            <p class="mb-2">
              Настоящая Политика конфиденциальности определяет порядок обработки и защиты персональных данных
              пользователей сайта «Мемориал Корпечь, Крым» (далее — Сайт).
            </p>
          </section>

          <section class="mb-6">
            <h2 class="text-xl font-semibold mb-3">2. Сбор данных</h2>
            <p class="mb-2">Сайт использует следующие сервисы аналитики:</p>
            <ul class="list-disc pl-6 mb-2">
              <li><strong>Яндекс.Метрика</strong> (ID: 112710769) — работает без требования согласия (РФ-контур)</li>
              <li><strong>Google Analytics</strong> (G-HXZMBB2CVJ) — подключается только после явного согласия пользователя</li>
            </ul>
          </section>

          <section class="mb-6">
            <h2 class="text-xl font-semibold mb-3">3. Согласие на обработку данных</h2>
            <p class="mb-2">
              При первом посещении Сайта пользователю предлагается дать согласие на обработку персональных данных
              с использованием трансграничной передачи (Google Analytics). Пользователь может:
            </p>
            <ul class="list-disc pl-6 mb-2">
              <li>Принять условия — будут подключены все сервисы аналитики</li>
              <li>Отказаться — будет работать только Яндекс.Метрика, Сайт останется полностью доступным</li>
            </ul>
          </section>

          <section class="mb-6">
            <h2 class="text-xl font-semibold mb-3">4. Комментарии</h2>
            <p class="mb-2">
              Система комментариев работает через сервис Giscus (GitHub). Для отображения комментариев также
              требуется согласие пользователя на передачу данных.
            </p>
          </section>

          <section class="mb-6">
            <h2 class="text-xl font-semibold mb-3">5. Управление настройками</h2>
            <p class="mb-2">
              Пользователь может в любой момент изменить свои настройки согласия, нажав на ссылку
              «Настройки данных» в подвале Сайта.
            </p>
          </section>

          <section class="mb-6">
            <h2 class="text-xl font-semibold mb-3">6. Контакты</h2>
            <p class="mb-2">
              По вопросам обработки персональных данных обращайтесь:
              <a href="mailto:anna.churasheva@gmail.com" class="underline text-blue-600 hover:text-blue-800">
                anna.churasheva@gmail.com
              </a>
            </p>
          </section>

          <footer class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
            <p class="text-sm text-gray-600 dark:text-gray-400">
              Редакция от 16 сентября 2026 г.
            </p>
          </footer>
        </article>
      )}
    </main>
  </body>
</html>
