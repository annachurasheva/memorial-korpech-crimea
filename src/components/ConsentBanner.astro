---
import { getConsent } from '@/utils/consent'
---

<script is:root>
  const CONSENT_KEY = 'mem-consent'

  function showBanner() {
    const consent = localStorage.getItem(CONSENT_KEY)
    if (consent === null) {
      document.getElementById('consent-banner')?.classList.remove('hidden')
    }
  }

  function acceptConsent() {
    localStorage.setItem(CONSENT_KEY, '1')
    location.reload()
  }

  function declineConsent() {
    localStorage.setItem(CONSENT_KEY, '0')
    document.getElementById('consent-banner')?.classList.add('hidden')
  }

  function resetSettings() {
    localStorage.removeItem(CONSENT_KEY)
    location.reload()
  }

  window.acceptConsent = acceptConsent
  window.declineConsent = declineConsent
  window.resetSettings = resetSettings

  document.addEventListener('astro:page-load', showBanner)
</script>

<div id="consent-banner" class="fixed bottom-0 left-0 right-0 bg-gray-900 text-white p-4 hidden z-50">
  <div class="container mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-sm">
      Мы используем файлы cookie и сервисы аналитики для улучшения работы сайта.
      Продолжая использование сайта, вы соглашаетесь с нашей
      <a href="/privacy/" class="underline hover:text-yellow-300">Политикой конфиденциальности</a>.
    </p>
    <div class="flex gap-2">
      <button
        onclick="acceptConsent()"
        class="bg-green-600 hover:bg-green-700 px-4 py-2 rounded text-sm font-medium transition-colors"
      >
        Согласен
      </button>
      <button
        onclick="declineConsent()"
        class="bg-gray-600 hover:bg-gray-700 px-4 py-2 rounded text-sm font-medium transition-colors"
      >
        Отказаться
      </button>
    </div>
  </div>
</div>
